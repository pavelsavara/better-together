// jsco-multiplex — a generic, declarative multiplexer for resource-bearing interfaces.
//
// One host implementation virtualizes ANY resource interface (filesystem, sockets,
// http, or a custom contract such as better-together's `gardener`) across many
// provider component instances. The host classifies calls purely from the
// component model's own `[constructor]` / `[static]` / `[method]` / `[resource-drop]`
// naming, so it never needs to understand the interface's semantics.
//
// POLICY is declarative: the consumer installs `rule`s that the host evaluates
// itself. The host never calls back into a guest, so routing introduces no
// re-entrance. Rules apply ONLY at root creation points (constructors / factory
// functions). A handle derived from an already-bound handle INHERITS its parent's
// provider automatically (sticky binding), so a whole resource lineage stays on
// one provider without any per-method routing token.
package jsco:multiplex@0.1.0;

/// The control plane. The consumer instantiates providers, installs routing
/// rules, and opts interfaces into virtualization. The DATA plane is the
/// standard virtualized interface itself (e.g. `better-together:gardener/player`),
/// which the host proxies — provider identity lives only here.
interface registry {
    /// A live provider: a component instance that EXPORTS the virtualized
    /// interface(s). Owned by the consumer; rules reference it by `provider-ref`.
    /// Dropping it tears the instance down and invalidates rules pointing at it.
    resource provider {
        /// Stable token naming this provider inside routing rules.
        id: func() -> provider-ref;
        /// Human-readable label (e.g. the source URL or the provider's reported
        /// name) for diagnostics and logging.
        label: func() -> string;
    }

    /// An opaque, stable reference to a provider, usable inside rules.
    type provider-ref = u64;

    /// Where the host loads a provider component from.
    variant provider-source {
        /// Raw component bytes supplied inline by the consumer.
        bytes(list<u8>),
        /// A URL the HOST fetches (https:, file:, data:, or an embedder-
        /// registered scheme/name). Keeps large component bytes out of guest
        /// memory.
        url(string),
    }

    /// Failure modes for control-plane operations.
    variant multiplex-error {
        /// A `url` source could not be fetched (bad scheme, unreachable, 404).
        fetch-failed(string),
        /// The bytes were not a component, or its own imports were unsatisfiable.
        instantiation-failed(string),
        /// The provider does not export the interface being virtualized.
        unknown-interface(string),
        /// A rule referenced an unknown provider or was malformed.
        bad-rule(string),
        /// A capability policy was unsatisfiable, e.g. `isolate` was requested for
        /// an interface with no registered isolation factory.
        bad-policy(string),
    }

    // ──────────────── Capability attenuation ────────────────

    /// How the host satisfies ONE of a provider's own imports. Always an
    /// attenuation of the caller's grants — never a grant beyond them.
    variant capability-mode {
        /// Hand the provider the caller's OWN instance (shared state).
        share,
        /// Give the provider a fresh, isolated instance from a host factory.
        isolate,
        /// Do not provide this interface at all.
        deny,
    }

    /// A per-interface exception to the policy default (longest prefix wins).
    record capability-grant {
        /// Interface (or interface-id prefix) this grant applies to.
        interface-id: string,
        mode: capability-mode,
    }

    /// How a provider's imports are satisfied. `default` applies to every
    /// caller-held interface not named in `overrides`. Resolution iterates only
    /// the caller's OWN grants, so an override naming an interface the caller
    /// lacks is ignored — a policy can only narrow, never widen.
    record capability-policy {
        default: capability-mode,
        overrides: list<capability-grant>,
        /// Per-provider virtual-filesystem byte quota, plumbed to the `isolate`
        /// factory. Meaningful only under `isolate` (a shared VFS can't be
        /// quota'd). Absent = the factory's own default.
        max-vfs-bytes: option<u64>,
    }

    /// Instantiate a provider from inline bytes OR a host-fetched URL. The
    /// provider's own imports are satisfied by attenuating the host's grants
    /// through `capabilities` (absent = isolate everything the caller holds).
    /// Async: fetch + compile + instantiate.
    instantiate-provider: async func(source: provider-source, capabilities: option<capability-policy>)
        -> result<provider, multiplex-error>;

    // ──────────────── Declarative routing policy ────────────────

    /// A type-erased test applied to one named argument of a creation call.
    /// The host compares it against its best-effort view of the argument value.
    variant predicate {
        /// Matches unconditionally (used for argument-less creators).
        any,
        /// Exact string match. Enum/variant arguments compare by case name.
        equals(string),
        /// String prefix match (e.g. a leading path segment or id prefix).
        prefix(string),
        /// Exact integer match.
        number(s64),
    }

    /// One condition of a rule: argument `name` must satisfy `test`.
    record arg-match {
        /// The creation function's parameter name (component model order).
        name: string,
        test: predicate,
    }

    /// Provider selection applied when a rule matches.
    variant target {
        /// Bind the new handle to exactly this provider.
        use-provider(provider-ref),
        /// Spread successive matching creations across ALL registered providers
        /// in registration order, wrapping around — one seat per provider.
        round-robin,
        /// Spread across an explicit subset, in order.
        among(list<provider-ref>),
    }

    /// What the host does when a forward INTO a provider traps (panics / aborts).
    /// Because every provider is its own component instance behind the host's
    /// proxy, a provider trap is caught at the proxy seam; this chooses what the
    /// caller observes. The strategy is picked by the rule that created the handle
    /// and inherited by the whole resource lineage (sticky), like provider binding.
    variant fault-strategy {
        /// Re-throw the trap into the caller — the caller traps too. Default.
        propagate,
        /// Convert the trap into the UNIT `err` case of the function's `result`.
        /// It fires only for functions that RETURN a unit `result<t>`; the host
        /// produces a bare `err` and never fabricates an error payload. A trap in
        /// any other function in the lineage still propagates. The provider is
        /// poisoned either way (see below).
        fail-result,
    }

    // NOTE: a trapped provider is POISONED — the Component Model forbids reusing a
    // trapped instance, so the host never forwards into it again. Subsequent calls
    // take the same fault path immediately (unit `err` under `fail-result`, else a
    // propagated trap). The blast radius is a single provider seat.

    /// A declarative routing rule. Matches a root-creation call site by
    /// interface + function + all argument predicates (AND), then binds the
    /// resulting handle to a provider. Method / derived calls are never matched
    /// here — they inherit their handle's binding automatically.
    record rule {
        /// Interface whose creation call this rule governs,
        /// e.g. "better-together:gardener/player".
        interface-id: string,
        /// The creation function, by its component-model name: a bare interface
        /// function ("create"), a "[constructor]<res>", or a "[static]<res>.<fn>".
        function: string,
        /// All conditions must hold. An empty list matches any arguments.
        when: list<arg-match>,
        /// Provider selection on match.
        then: target,
        /// How traps on the resulting handle's lineage are handled. Absent =
        /// `propagate`.
        on-fault: option<fault-strategy>,
    }

    /// Install a rule. Rules are evaluated in installation order; first match
    /// wins. A creation call that matches no rule TRAPS; likewise a method call
    /// on a handle that was never bound by a rule TRAPS — there is no silent
    /// pass-through.
    add-rule: func(rule: rule) -> result<_, multiplex-error>;

    /// Begin proxying every import of `interface-id`. After this, creation calls
    /// are routed by the installed rules, method calls forward to their handle's
    /// bound provider, and passing handles bound to different providers into one
    /// call traps.
    virtualize: func(interface-id: string) -> result<_, multiplex-error>;

    /// The providers currently registered, in registration order. The consumer
    /// uses the length to learn the seat count; the refs are also usable as
    /// `among` targets and for diagnostics.
    seats: func() -> list<provider-ref>;
}

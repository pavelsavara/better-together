// The world the `nib` sample builds against — informational only.
//
// Unlike the other samples, `nib` is NOT generated from this WIT: it is
// hand-written WebAssembly text (see ../src/nib.wat) and assembled directly
// with `wasm-tools parse`. This file documents the shape the finished component
// actually has so it can be diffed against the contract and read alongside the
// siblings.
//
// `nib` reaches stdout itself (it has no language runtime to do it), so unlike
// ferris/corro/gopher it explicitly imports the three wasi:io / wasi:cli
// interfaces it uses for banter. Those imports are declared in the .wat; they
// are noted here in a comment rather than in the world because pulling them in
// would require vendoring the wasi WIT, which the build does not need.
//
//   import wasi:io/error@0.2.3;     // (transitively, for stream-error)
//   import wasi:io/streams@0.2.3;   // output-stream.blocking-write-and-flush
//   import wasi:cli/stdout@0.2.3;   // get-stdout
package better-together:nib@0.1.0;

/// A single Nib player component: a WASI 0.2.3 reactor that exports the
/// Better Together player interface. Hand-written in raw component-model WAT.
world nib {
    export better-together:gardener/player@0.1.0;
}

// The world the `ferris` sample actually builds against.
//
// It exports nothing but the player data plane. The console and virtual
// filesystem the README/gardener world grant are reached through Rust `std`
// (the wasm32-wasip2 target maps std::fs / std::env / println! onto the
// corresponding wasi:* imports automatically), so they don't need to appear
// here. This keeps the bindgen surface to just the interface we implement.
package better-together:ferris@0.1.0;

/// A single Ferris player component: a WASI 0.2.3 reactor that exports the
/// Better Together player interface.
world ferris {
    export better-together:gardener/player@0.1.0;
}

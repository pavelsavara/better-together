// Vendored data-plane contract for the `attacker` sample.
//
// A trimmed copy of ../../../../wit/gardener.wit containing ONLY the `types` and
// `player` interfaces — the part a player component implements. The wasi:*
// imports are reached through Rust `std` on wasm32-wasip2 and so are kept out of
// the bindgen world (see world.wit).
package better-together:gardener@0.1.0;

/// Shared value types used by both the player and the engine.
interface types {
    /// A persistent, globally unique player identity (e.g. a component name).
    type player-id = string;

    /// A player component's self-description: who wrote it and where it lives.
    record metadata {
        // `name` is `namespace.name` (e.g. "together.Attacker"); the namespace
        // is validated by the engine and must match `^[a-z][a-z0-9-]*$`.
        name: string,
        version: string,
        author: string,
        repo: string,
        lore: string,
        // A single UTF character (emoji/glyph) shown on the garden in the UI.
        glyph: string,
        // URL of an avatar picture, or none if the player has no avatar.
        icon: option<string>,
    }

    /// The public broadcast a player emits each round. Cheap talk.
    enum signal {
        bloom,
        hold,
        watch,
    }

    /// A tax-phase ballot: the player to tax this round, or none to abstain.
    type ballot = option<player-id>;

    /// One player's ballot in the vote phase, revealed to everyone afterwards.
    record vote-record {
        voter: player-id,
        target: option<player-id>,
    }

    /// What a single player did in a given round, revealed to everyone.
    record player-action {
        id: player-id,
        plant: u8,
        signal: signal,
    }

    /// The fully resolved outcome of one round, broadcast to all players.
    record round-result {
        actions: list<player-action>,
        garden-total: u16,
        votes: list<vote-record>,
        tax-target: option<player-id>,
        tax-collected: u8,
        garden-payout: f32,
    }

    /// Delivered once at the start of a match, before any rounds.
    record match-context {
        match-id: string,
        players: list<player-id>,
        self-id: player-id,
        group-size: u8,
    }

    /// One player's broadcast for the CURRENT round.
    record signal-broadcast {
        id: player-id,
        signal: signal,
    }

    /// Delivered to `talk`, `plant`, and `vote` each round.
    record round-state {
        round: u8,
        history: list<round-result>,
        signals: list<signal-broadcast>,
        plants: list<player-action>,
    }

    /// Delivered once when the match ends.
    record match-summary {
        rounds-played: u8,
        final-scores: list<tuple<player-id, f32>>,
        your-score: f32,
    }
}

/// The contract every player component implements.
interface player {
    use types.{metadata, signal, ballot, match-context, round-state, match-summary};

    /// Static factory: create a new player instance.
    create: func() -> result<gardener>;

    /// A single seated player.
    resource gardener {
        metadata: func() -> result<metadata>;
        match-start: func(context: match-context) -> result;
        talk: func(state: round-state) -> result<signal>;
        plant: func(state: round-state) -> result<u8>;
        vote: func(state: round-state) -> result<ballot>;
        match-end: func(summary: match-summary) -> result;
    }
}

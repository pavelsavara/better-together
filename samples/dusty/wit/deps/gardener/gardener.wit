// Vendored data-plane contract (types + player) for the spike.
package better-together:gardener@0.1.0;

interface types {
    type player-id = string;

    record metadata {
        // `name` is `namespace.name` (e.g. "together.Dusty"); the namespace
        // is validated by the engine and must match `^[a-z][a-z0-9-]*$`.
        name: string,
        version: string,
        author: string,
        repo: string,
        lore: string,
        // A single UTF character (emoji/glyph) shown on the garden in the UI.
        glyph: string,
        // URL of an avatar picture, or none if the player has no avatar.
        icon: option<string>,
    }

    enum signal {
        bloom,
        hold,
        watch,
    }

    type ballot = option<player-id>;

    record vote-record {
        voter: player-id,
        target: option<player-id>,
    }

    record player-action {
        id: player-id,
        plant: u8,
        signal: signal,
    }

    record round-result {
        actions: list<player-action>,
        garden-total: u16,
        votes: list<vote-record>,
        tax-target: option<player-id>,
        tax-collected: u8,
        garden-payout: f32,
    }

    record match-context {
        match-id: string,
        players: list<player-id>,
        self-id: player-id,
        group-size: u8,
    }

    record signal-broadcast {
        id: player-id,
        signal: signal,
    }

    record round-state {
        round: u8,
        history: list<round-result>,
        signals: list<signal-broadcast>,
        plants: list<player-action>,
    }

    record match-summary {
        rounds-played: u8,
        final-scores: list<tuple<player-id, f32>>,
        your-score: f32,
    }
}

interface player {
    use types.{metadata, signal, ballot, match-context, round-state, match-summary};

    create: func() -> result<gardener>;

    resource gardener {
        metadata: func() -> result<metadata>;
        match-start: func(context: match-context) -> result;
        talk: func(state: round-state) -> result<signal>;
        plant: func(state: round-state) -> result<u8>;
        vote: func(state: round-state) -> result<ballot>;
        match-end: func(summary: match-summary) -> result;
    }
}
